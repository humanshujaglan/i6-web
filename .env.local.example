# Upstash Redis (free tier: https://upstash.com) — required only by the /dashboard/downlines
# tree scan, which caches its multi-level result here. Every other page caches in Next.js
# itself and works without Redis; only /dashboard/downlines fails if these are unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dedicated BSC RPC endpoint for server-side contract reads (free tier: Ankr, Chainstack, NodeReal, or QuickNode).
BSC_RPC_URL=https://bsc-dataseed.binance.org
CHAIN_ID=56

# Reown AppKit / WalletConnect Project ID (from https://cloud.reown.com)
NEXT_PUBLIC_PROJECT_ID=
